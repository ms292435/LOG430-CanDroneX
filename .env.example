# Copier ce fichier en .env et remplacer chaque valeur (ne jamais versionner .env).

# --- Keycloak fourni : administrateur et secrets des clients de démonstration du realm candronex ---
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changez-moi
CANDRONEX_ADMIN_SECRET=changez-moi-admin
CLIENT_MANAGEMENT_SERVICE_SECRET=changez-moi-client-management
INSPECTRA_DEMO_SECRET=changez-moi-inspectra
AEROTECH_DEMO_SECRET=changez-moi-aerotech
# Tests seulement : client dont le jeton expire après 5 s (cas « jeton expiré -> 401 »)
JETON_COURT_SECRET=changez-moi-court

# --- Bases de données (une par microservice) ---
DRONE_DB_PASSWORD=changez-moi-drone-db

# Port publié de la passerelle (8080 par défaut)
GATEWAY_PORT=8080
