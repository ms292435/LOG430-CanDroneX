@startuml cartographie-domaine
!include commun.iuml
title Cartographie du domaine — bounded contexts et microservices

package "drone-management-service" as SDrone {
  rectangle "**Drones**\nagrégat Drone\nDroneId, IdentifiantMetier,\nIdentiteReseau (Imsi, TypeCarte)" as Drones
}

package "service-ordering-service" as SOrdering {
  rectangle "**Catalogue** (TMF633)\nagrégat ServiceSpecification\nCaracteristique (sst, sd, dnn, 5qi...)" as Catalogue
  rectangle "**Commandes** (TMF641)\nagrégat Commande\nElementDeCommande (offre figée)" as Commandes
}

package "slice-service" as SSlice {
  rectangle "**Service Activation** (TMF640)\nagrégat DemandeActivation\nConfigurationSlice, Imsi" as Activation
  rectangle "**Service Inventory** (TMF638)\nagrégat Service\nEtatService, activatedAt" as Inventaire
}

rectangle "**Customer Management**\nKeycloak fourni\n(client B2B = claim azp)" as Clients #FFFFFF
rectangle "**Réseau 5G**\n(Open5GS en Phase 3)" as Reseau #FFFFFF
rectangle "**Traçabilité**\nhors périmètre Phase 2\n(journaux corrélés)" as Tracabilite #FFFFFF

Catalogue --> Commandes : offre figée dans\nl'élément (en mémoire)
Drones --> Commandes : « le drone est-il au client ? »\nREST, client-fournisseur
Commandes --> Activation : demande d'activation par élément\nREST, idempotente (elementId)
Drones --> Activation : droneId → IMSI\nREST interne
Activation --> Inventaire : résultat reflété\n(même transaction)
Activation --> Reseau : NetworkProvisioningPort\n(couche anticorruption)
Clients ..> Drones : identité du client (azp)
Clients ..> Commandes
Clients ..> Inventaire
Commandes ..> Inventaire : suivi de l'état\n(relu par Commande)
@enduml
