@startuml contexte-metier
!include commun.iuml
title Contexte métier — Phase 2 (UC-02, UC-04, UC-06)

actor "Client B2B\n(Inspectra Drone Services)\napplication cliente" as Client
actor "Administrateur\nde plateforme" as Admin
actor "Back-office\nopérations télécom" as BackOffice

rectangle "CanDroneX" as CanDroneX #EEF2F8 {
  usecase "UC-02\nEnregistrer un drone\net son identité réseau" as UC02
  usecase "UC-04\nCommander les services\nd'un drone (C2 + Imagerie)" as UC04
  usecase "UC-06\nActiver et configurer\nune slice" as UC06
  usecase "Suivre la commande\net l'état des slices" as Suivi
}

rectangle "Keycloak fourni\n(realm candronex)" as Keycloak
rectangle "Réseau 5G\n(simulé : MockOpen5GSAdapter)" as Reseau

Client --> UC02 : droneId, IMSI,\nSIM / eSIM
Client --> UC04 : un élément\npar service
Client --> Suivi
UC04 ..> UC06 : chaque élément\ndéclenche une activation
UC06 --> Reseau : configuration de slice\n(IMSI, S-NSSAI, DNN, 5QI)
Reseau --> UC06 : résultat réel\n(succès / échec)
Client --> Keycloak : jeton\n(client credentials)
Admin --> Keycloak : comptes B2B\n(hors périmètre)
BackOffice ..> Suivi : états d'activation\n(hors périmètre)
@enduml
