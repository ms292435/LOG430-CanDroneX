@startuml sequence-uc04-commande
!include commun.iuml
title UC-04 puis UC-06 (1/2) : commande C2 + Imagerie et demandes d'activation
autonumber "<b>0."

actor "Client B2B" as Client
participant "API Gateway" as GW
participant "service-ordering-\nservice" as Ordering
participant "drone-management-\nservice" as Drone
participant "slice-service" as Slice

Client -> GW : POST .../serviceOrder\nBearer, Idempotency-Key: K\nC2_URLLC + IMAGERIE_EMBB (DRN-0231)
GW -> Ordering : requête transmise\n(Bearer, clé, corrélation)
Ordering -> Ordering : commande déjà connue pour (client, K) ?\nmême contenu → 200, autre contenu → 409
Ordering -> Drone : GET .../drone/{droneId}\n(même jeton ; 2 s, 1 reprise)
Drone --> Ordering : 200 : drone du client
Ordering -> Ordering : offres figées dans les éléments ;\ncommande + 2 éléments EN_ATTENTE,\nacceptedAt (une transaction)

loop pour chaque élément (en parallèle)
  Ordering -> Slice : POST .../activation\nelementId, offre figée, acceptedAt\n(même jeton)
  Slice -> Slice : demande déjà connue\npour elementId ? → 200
  Slice -> Drone : GET .../drone/{droneId}/identiteReseau
  Drone --> Slice : 200 { imsi, typeCarte }
  Slice -> Slice : ConfigurationSlice validée ;\ndemande RECUE + service EN_ACTIVATION\n(une transaction) ; mise en file
  Slice --> Ordering : 202 { serviceId, etat RECUE }
  Ordering -> Ordering : élément EN_ACTIVATION
end

Ordering --> GW : 201 Location .../serviceOrder/{id}\netat EN_COURS
GW --> Client : 201

alt drone-management-service injoignable (étape 4)
  Ordering --> Client : 503 : rien n'est enregistré,\nle client rejoue avec la même clé K
else slice-service injoignable (étape 7)
  Ordering --> Client : 201, éléments EN_ATTENTE :\nenvoi relancé au prochain GET\nou au rejeu de K
end

legend right
  **Légende**
  flèche pleine : requête synchrone
  flèche pointillée : réponse
  flèche vers soi-même : traitement interne
  (persistance comprise)
  « même jeton » : le JWT du client est
  propagé tel quel entre services
endlegend
@enduml
