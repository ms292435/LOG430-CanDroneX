@startuml hexagone-slice-service
!include commun.iuml
title Architecture hexagonale — slice-service (UC-06)
left to right direction

package "Adaptateurs d'entrée (SliceService.Api, .Infrastructure)" as Entree {
  component "ActivationController\nPOST/GET api/service-activation/v1" as CtrlActivation
  component "ServiceInventoryController\nGET api/service-inventory/v1" as CtrlInventaire
  component "ProcesseurActivations\n(BackgroundService, file Channel)" as Processeur
}

package "Application (SliceService.Application)" as App {
  interface "IReceptionActivations" as PReception
  interface "ITraitementActivations" as PTraitement
  interface "IConsultationInventaire" as PConsultation
  component "ReceptionActivations\nTraitementActivations\nConsultationInventaire" as Services

  package "Domaine (SliceService.Domain)" as Domaine #FFFFFF {
    component "DemandeActivation\nConfigurationSlice, Imsi" as Activation
    component "Service (inventaire)\nEtatService" as Inventaire
  }

  interface "IActivationRepository\nIInventaireRepository" as PDepot
  interface "IResolutionIdentiteReseau" as PIdentite
  interface "**INetworkProvisioningPort**" as PReseau
  interface "IFileActivations" as PFile
}

package "Adaptateurs de sortie (SliceService.Infrastructure)" as Sortie {
  component "ActivationRepositorySql\nActivationDao (Npgsql)" as Sql
  component "ResolutionIdentiteReseauHttp\n(jeton propagé, résilience)" as Http
  component "**MockOpen5GSAdapter**\nlatence, taux d'échec" as Mock
  component "Open5GSAdapter\n(Phase 3)" as Open5GS #FFFFFF
  component "FileActivationsEnMemoire" as File
}

database "slice-db" as Db
component "drone-management-service" as Drone

CtrlActivation --> PReception
CtrlInventaire --> PConsultation
Processeur --> PTraitement
PReception -- Services
PTraitement -- Services
PConsultation -- Services
Services --> Activation
Services --> Inventaire
Services --> PDepot
Services --> PIdentite
Services --> PReseau
Services --> PFile
Sql ..|> PDepot
Http ..|> PIdentite
Mock ..|> PReseau
Open5GS ..|> PReseau
File ..|> PFile
Sql --> Db
Http --> Drone

legend right
  **Légende**
  rond : port (interface) défini par l'application, nommé selon le besoin
  flèche pleine : dépendance d'utilisation (l'appelant connaît l'interface)
  flèche pointillée à pointe creuse : l'adaptateur implémente le port
  cadre blanc : Open5GSAdapter de la Phase 3, qui remplacera le mock
  sans modification du domaine ni de l'application
endlegend
@enduml
