@startuml decomposition-logique
!include commun.iuml
title Vue logique — microservices, API, données et dépendances

component "API Gateway (KrakenD CE)" as Passerelle

node "drone-management-service" as SDrone {
  portin "drone-management v1\n(public)" as ApiDrone
  portin "identiteReseau\n(interne)" as ApiIdentite
  rectangle "Drones" as BcDrones
}
database "drone-db\nschéma drones" as DbDrone

node "service-ordering-service" as SOrdering {
  portin "service-ordering v1\nservice-catalog v1\n(publics)" as ApiOrdering
  rectangle "Commandes" as BcCommandes
  rectangle "Catalogue" as BcCatalogue
}
database "ordering-db\nschémas commandes, catalogue" as DbOrdering

node "slice-service" as SSlice {
  portin "service-inventory v1\n(public)" as ApiInventaire
  portin "service-activation v1\n(interne)" as ApiActivation
  rectangle "Service Activation" as BcActivation
  rectangle "Service Inventory" as BcInventaire
  rectangle "MockOpen5GSAdapter" as Mock
}
database "slice-db\nschémas activation, inventaire" as DbSlice

Passerelle --> ApiDrone
Passerelle --> ApiOrdering
Passerelle --> ApiInventaire

SDrone --> DbDrone
SOrdering --> DbOrdering
SSlice --> DbSlice

BcCommandes --> ApiDrone : GET drone/{droneId}\n(appartenance)
BcCommandes --> ApiActivation : POST activation\nGET activation?elementId=
BcActivation --> ApiIdentite : GET .../identiteReseau
BcActivation --> Mock : NetworkProvisioningPort

legend right
  **Légende**
  nœud : microservice (un conteneur) ; cylindre : base PostgreSQL du service
  rectangle intérieur : bounded context ; demi-carré : API exposée
  flèche : appel REST synchrone (ou port interne vers le réseau simulé),
  orienté de l'appelant vers l'appelé ; aucune flèche ne revient vers
  service-ordering-service : le graphe des dépendances est sans cycle
endlegend
@enduml
